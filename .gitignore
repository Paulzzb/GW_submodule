# MATLAB / editor
*.asv
*.html
*.mex*
*QPenergy
QPen*

# Generic GW run products
*.mat
SAVE/
isdf_report/
isdf/
direct/
qp.dat
qp_*.dat
qp.dir
qp.ben
qp.isdf
Ecoh.*
r-*.log
l-*.log

# QE stdout / crash (inputs and UPF stay tracked)
scf.out
nscf.out
pp.out
CRASH

# ---------------------------------------------------------------------------
# benchmarks/: QE GS is local; only namelists / UPF / SLURM / README are kept
# ---------------------------------------------------------------------------
benchmarks/**/*.save/
benchmarks/**/vxc.dat
benchmarks/**/wfn*
benchmarks/**/rho.complex
benchmarks/log/

# ---------------------------------------------------------------------------
# tests/: large QE dumps stay local; keep README placeholders.
# Already-tracked small Si_gamma / Si_k qe.save files remain in the index.
# ---------------------------------------------------------------------------
tests/cases/**/qe.save/**
!tests/cases/**/qe.save/README.md
tests/**/vxc.dat
tests/**/wfn*
tests/**/rho.complex

# ---------------------------------------------------------------------------
# examples/: shared examples/cases/qe.save is shipped — do not ignore it.
# Per-case run products are covered by the generic rules above.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# test_profile/: local scratch (not the public examples/tests trees)
# ---------------------------------------------------------------------------
test_profile/**/*.save/
test_profile/**/vxc.dat
test_profile/**/*report*.txt
test_profile/**/*报告*.txt
test_profile/**/adaptiveisdf_id*.txt
test_profile/**/isdf_validate_HF*.txt
test_profile/**/HF_ratio*.txt
test_profile/**/adapt_ratio*.txt
test_profile/**/coarse_FFT_direct.txt
test_profile/**/*log*.txt
