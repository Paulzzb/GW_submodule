&control
   prefix = 'STO2'
   calculation = 'scf'
   restart_mode = 'from_scratch'
   wf_collect = .true.
   outdir = './'
   wfcdir = './'
   pseudo_dir = './'
/
&system
   ibrav = 0
   nat = 40
   ntyp = 3
   ecutwfc = 80.0
   occupations = "fixed",
/
