&control
   prefix = 'Si8'
   calculation = 'nscf'
   restart_mode = 'from_scratch'
   outdir = './'
   wfcdir = './'
   pseudo_dir = '../Si64'
/
&system
   ibrav = 0
   nat = 8
   ntyp = 1
   nbnd = 2048
   ecutwfc = 40.0
!   ecutrho = 20.0
   nosym = .TRUE.
   nosym_evc = .true.
   occupations = "fixed",
!    occupations = "smearing",
!    smearing    = "gaussian",
!    degauss     = 0.01
/
&electrons
   conv_thr = 1.0d-6
   diago_full_acc = .true.
   diagonalization='cg'
/
