&control
   prefix = 'Si64'
   calculation = 'scf'
   restart_mode = 'from_scratch'
   wf_collect = .true.
   outdir = './'
   wfcdir = './'
   pseudo_dir = './'
/
&system
   ibrav = 0
   nat = 64
   ntyp = 1
   ecutwfc = 50.0
   occupations = "fixed",
/
&electrons
   electron_maxstep = 100
   conv_thr = 1.0d-8
   mixing_mode = 'plain'
   diagonalization = 'david'
   diago_david_ndim = 2
   diago_full_acc = .true.
/
