&CONTROL
  prefix = 'Si64',
  isgw = 1,
  groundstate_dir = './Si64.save',
  groundstate_type = 'qe',
  storage_dir = './SAVE',
  output_dir = './direct',
  enable_k_points = .false.,
END &CONTROL

&SYSTEM
  number_bands_in_summation = 14335,
  energy_band_index_min = 1,
  energy_band_index_max = 256,
END &SYSTEM

&FREQUENCY
  frequency_dependence = -2,
END &FREQUENCY

&CUTOFFS
  coulomb_cutoff = 40.0,
  coulomb_truncation_method = 2,
  coulomb_truncation_parameter = 5.0,
END &CUTOFFS

&ISDF
  isisdf = 0,
  compute_vc = .true.,
  compute_vn = .true.,
  compute_nn = .true.,
  isdf_ratio_type1 = 12.0,
  isdf_ratio_type2 = 24.0,
  isdf_ratio_type3 = 16.0,
  exxmethod = 'kmeans',
  seed = 0,
  init = 'random',
  weight = 'add',
  is_helper = .true.,
  validate_hf = .true.,
  inv_strategy = 'dir',
  inv_param = 1e-12,
  inv_ratio = 0.75,
  auto_inv_param = .false.,
  order = 1,
  iscauchy = .true.,
END &ISDF

&COHSEX
  exact_ch = .false.,
  ex_use_which_isdf = 'vn',
END &COHSEX
