#!/bin/bash -l
#SBATCH -t 02:00:00
#SBATCH -p normal
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 40
#SBATCH -w largememory

RUNMATLAB=matlab
SCRIPT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
GW_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

cd "$SCRIPT_DIR" || exit 1
mkdir -p "$SCRIPT_DIR/log"
rm -f "$SCRIPT_DIR"/slurm*

$RUNMATLAB -nodisplay -nodesktop -nosplash -logfile "$SCRIPT_DIR/log/run_sc_test.log" -r "addpath('$GW_ROOT/test_profile/test_SC'); run_sc_test('$SCRIPT_DIR'); exit"
