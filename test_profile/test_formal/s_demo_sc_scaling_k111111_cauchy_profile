#!/bin/bash -l
#SBATCH -J demo_sc_k111111_cauchy
#SBATCH -t 1200:00:00
#SBATCH -p normal
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --exclusive
#SBATCH -w largememory
#
# LiH [11 11 11] demo_sc_scaling with GW COmegaC via COmegaCstar (Cauchy).
# Reuses ISDF cache from prior direct-GW run; writes to separate out/log dirs
# so LiH_111111_demo_scaling/ (direct) is preserved.
#
#   sbatch /data-storage/home/huwei/zzb/GW_double_test/test_profile/test_formal/s_demo_sc_scaling_k111111_cauchy_profile

set -euo pipefail

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1

RUNMATLAB="${RUNMATLAB:-/public/software/MATLAB/R2023a/bin/matlab}"
GW_ROOT="/data-storage/home/huwei/zzb/GW_double_test"
FORMAL_DIR="${GW_ROOT}/test_profile/test_formal"
UC_SAVE_DIR="${UC_SAVE_DIR:-${GW_ROOT}/test_profile/test_SC/LiH_111/SAVE}"
OUT_DIR="${OUT_DIR:-${FORMAL_DIR}/LiH_111111_demo_scaling_cauchy}"
LOG_DIR="${FORMAL_DIR}/log"
LOG_FILE="${LOG_DIR}/demo_sc_scaling_k11_11_11_cauchy_profile.log"

mkdir -p "$LOG_DIR" "$OUT_DIR"
cd "$FORMAL_DIR" || exit 1

echo "=== demo_sc_scaling [11 11 11] Cauchy GW profile run ==="
echo "GW_ROOT      = $GW_ROOT"
echo "UC_SAVE_DIR  = $UC_SAVE_DIR"
echo "OUT_DIR      = $OUT_DIR"
echo "SLURM_CPUS_PER_TASK = ${SLURM_CPUS_PER_TASK:-unset}"
echo "SLURM_CPUS_ON_NODE  = ${SLURM_CPUS_ON_NODE:-unset}"
echo "HOST_CPUS (nproc)   = $(nproc)"
echo "LOG_FILE     = $LOG_FILE"
echo "Started at   = $(date -Is)"
echo "============================================"

"$RUNMATLAB" -nodisplay -nodesktop -nosplash -logfile "$LOG_FILE" -r \
  "addpath('${FORMAL_DIR}'); \
   prof_opts=struct('use_cauchy',true,'use_isdf_cache',true); \
   report=run_demo_sc_scaling_profile('${UC_SAVE_DIR}', [11 11 11], '${OUT_DIR}', prof_opts); \
   fprintf('FINISHED wall=%.3f s profile=%s use_cauchy=%d\n', report.wall_s, report.profile_dir, report.use_cauchy); \
   exit;"

echo "Finished at  = $(date -Is)"
echo "Report: ${OUT_DIR}/demo_sc_scaling_report.txt"
echo "Profile: ${OUT_DIR}/profile_demo_sc/index.html"
echo "Log: $LOG_FILE"
echo "(direct run preserved at ${FORMAL_DIR}/LiH_111111_demo_scaling/)"
