#!/bin/bash -l
#SBATCH -J demo_sc_scaling
#SBATCH -t 04:00:00
#SBATCH -p normal
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --exclusive
#SBATCH -w largememory
#
# Formal demo_sc_scaling (+ demo_isdf_scaling) smoke / benchmark.
# Worker count from resolve_parpool_workers() (Slurm allocation or host nproc).
#
# Submit (when ready):
#   sbatch /data-storage/home/huwei/zzb/GW_double_test/test_profile/test_formal/s_demo_sc_scaling
#
# Override defaults without editing this file:
#   UC_SAVE_DIR=/data-storage/home/huwei/zzb/GW_double_test/test_profile/test_SC/LiH_111/SAVE \
#     K1=2 K2=2 K3=2 \
#     sbatch /data-storage/home/huwei/zzb/GW_double_test/test_profile/test_formal/s_demo_sc_scaling
#
# Run interactively on login node (no Slurm):
#   bash /data-storage/home/huwei/zzb/GW_double_test/test_profile/test_formal/s_demo_sc_scaling

set -euo pipefail

RUNMATLAB="${RUNMATLAB:-matlab}"
GW_ROOT="/data-storage/home/huwei/zzb/GW_double_test"
FORMAL_DIR="${GW_ROOT}/test_profile/test_formal"

UC_SAVE_DIR="${UC_SAVE_DIR:-${GW_ROOT}/test_profile/test_SC/LiH_111/SAVE}"
K1="${K1:-2}"
K2="${K2:-2}"
K3="${K3:-2}"

LOG_DIR="${FORMAL_DIR}/log"
LOG_FILE="${LOG_DIR}/demo_sc_scaling_k${K1}_${K2}_${K3}.log"

mkdir -p "$LOG_DIR"
cd "$FORMAL_DIR" || exit 1

if [[ -n "${SLURM_JOB_ID:-}" ]]; then
  rm -f "${FORMAL_DIR}"/slurm*
fi

echo "=== demo_sc_scaling ==="
echo "GW_ROOT      = $GW_ROOT"
echo "FORMAL_DIR   = $FORMAL_DIR"
echo "UC_SAVE_DIR  = $UC_SAVE_DIR"
echo "k1k2k3              = [$K1 $K2 $K3]"
echo "SLURM_CPUS_PER_TASK = ${SLURM_CPUS_PER_TASK:-unset}"
echo "SLURM_CPUS_ON_NODE  = ${SLURM_CPUS_ON_NODE:-unset}"
echo "HOST_CPUS (nproc)   = $(nproc)"
echo "LOG_FILE     = $LOG_FILE"
echo "Started at   = $(date -Is)"
echo "========================"

"$RUNMATLAB" -nodisplay -nodesktop -nosplash -logfile "$LOG_FILE" -r \
  "addpath('${GW_ROOT}/test_profile/test_formal'); \
   demo_sc_scaling('${UC_SAVE_DIR}', [${K1} ${K2} ${K3}]); \
   exit;"

echo "Finished at  = $(date -Is)"
echo "Log: $LOG_FILE"
