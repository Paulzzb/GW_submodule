&CONTROL
  prefix = 'Si8',
  isgw = 1,
  groundstate_dir = '../../test_Si/Si.save',
  groundstate_type = 'formal',
  storage_dir = './SAVE',
  enable_k_points = .false.
  log_file = 'QPlog',
END &CONTROL

&SYSTEM
  number_bands_in_summation = 32,
  energy_band_index_min = 1,
  energy_band_index_max = 32,
END &SYSTEM

&FREQUENCY
  frequency_dependence = -2,
END &FREQUENCY

&CUTOFFS
  coulomb_cutoff = 15.0
  coulomb_truncation_parameter = 5.0
  coulomb_truncation_method = 2,
END &CUTOFFS

&ISDF
  isisdf = 1
  compute_vc = .true.
  compute_vn = .true.
  compute_nn = .false.
  isdf_ratio_type1 = 4.0
  isdf_ratio_type2 = 4.0
  exxmethod = 'pseudo'
  is_helper = .false.
  inv_strategy = 'pseudo'
  inv_param = 1e-12
  inv_ratio = 0.75
  order = 1
  validate_hf = .false.
END &ISDF

&SUPERCELL
  is_supercell = .true.
  use_sc_isdf = .true.
  k1 = 2
  k2 = 2
  k3 = 1
  isdf_source_dir = '../../test_SC/Si2/SAVE'
END &SUPERCELL

&FORMAL
  wf_seed = 7
  eo_e0 = -1.5
  eo_delta = 0.04
  run_qp_cohsex = .true.
END &FORMAL

&COHSEX
  exact_ch = .true.
  Ex_use_which_isdf = 'vn'
END &COHSEX
