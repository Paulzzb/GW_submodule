&CONTROL
  prefix = 'Si8',
  isgw = 1,
  groundstate_dir = '../Si8.save',
  groundstate_type = 'qe',
  storage_dir = './SAVE',
  enable_k_points = .true.
  log_file = 'QPlog',
END &CONTROL

&SYSTEM
  number_bands_in_summation = 319,
  energy_band_index_min = 1,
  energy_band_index_max = 32,
END &SYSTEM

&FREQUENCY
  frequency_dependence = 2,
  frequency_dependence_method = 2
  frequency_low_cutoff = 20.0
  delta_frequency = 0.25
  number_imaginary_freqs = 20
END &FREQUENCY

&CUTOFFS
  coulomb_truncation_parameter = 5.0
  coulomb_truncation_method = 2,
  coulomb_cutoff = 15.0
END &CUTOFFS

&ISDF
  isisdf = 1
  compute_vc = .true.
  compute_vn = .true.
  compute_nn = .true.
  isdf_ratio_type1 = 8.0
  isdf_ratio_type2 = 3.0
  isdf_ratio_type3 = 4.0
  adaptive_threshold_type1 = 2.0e-5
  adaptive_threshold_type2 = 2.0e-5
  adaptive_num_add_type1 = 64
  adaptive_num_add_type2 = 64
  adaptive_candidate_ratio_type1 = 2.0
  adaptive_candidate_ratio_type2 = 2.0
  adaptive_max_add_frac_type1 = 1.0
  adaptive_max_add_frac_type2 = 1.0
  adaptive_batch_size = 256
  exxmethod = 'coarse'
  is_helper = .false.
  validate_hf = .false.
END &ISDF

&COHSEX
  exact_ch = .false.
END &COHSEX
