&CONTROL
  prefix = 'Si8_sc',
  isgw = 1,
  groundstate_dir = '../Si2_uc/qe.save',
  groundstate_type = 'formal',
  storage_dir = './SAVE',
  output_dir = './',
  enable_k_points = .false.,
  log_level = 1,
  log_file = 'QPlog',
END &CONTROL

&SYSTEM
  number_bands_in_summation = 32,
  energy_band_index_min = 1,
  energy_band_index_max = 32,
END &SYSTEM

&FREQUENCY
  frequency_dependence = -2,
END &FREQUENCY

&CUTOFFS
  coulomb_cutoff = 15.0,
  coulomb_truncation_parameter = 5.0,
  coulomb_truncation_method = 2,
END &CUTOFFS

&ISDF
  isisdf = 1,
  compute_vc = .true.,
  compute_vn = .true.,
  compute_nn = .false.,
  isdf_ratio_type1 = 4.0,
  isdf_ratio_type2 = 4.0,
  adaptive_threshold_type1 = 2.0e-6,
  adaptive_threshold_type2 = 2.0e-10,
  adaptive_num_add_type1 = 4,
  adaptive_num_add_type2 = 4,
  adaptive_candidate_ratio_type1 = 2.0,
  adaptive_candidate_ratio_type2 = 2.0,
  adaptive_max_cond_type1 = 1e+12,
  adaptive_max_cond_type2 = 1e+12,
  adaptive_batch_size = 64,
  exxmethod = 'pseudo',
  is_helper = .false.,
  inv_strategy = 'pseudo',
  inv_param = 1e-12,
  inv_ratio = 0.75,
  order = 1,
  validate_hf = .false.,
END &ISDF

&SUPERCELL
  is_supercell = .true.,
  use_sc_isdf = .true.,
  sc_adaptive = .true.,
  k1 = 2,
  k2 = 2,
  k3 = 1,
  isdf_source_dir = '../Si2_uc/SAVE',
END &SUPERCELL

&FORMAL
  wf_seed = 7,
  eo_e0 = -1.5,
  eo_delta = 0.04,
  run_qp = .true.,
  enable_profile = .false.,
END &FORMAL

&COHSEX
  exact_ch = .true.,
  ex_use_which_isdf = 'vn',
END &COHSEX
